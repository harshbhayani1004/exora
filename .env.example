# ==========================================
# EXORA E-Commerce Environment Configuration
# ==========================================

# 1. Database Configuration (PostgreSQL / Supabase / Neon)
# Direct connection URL or transaction pooler URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exora?schema=public"
# For Supabase:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Authentication & JWT Security
JWT_SECRET="exora-super-secret-jwt-key-change-in-production-2026"
JWT_EXPIRES_IN="7d"

# 3. Store Currency & Settings
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="2500"
NEXT_PUBLIC_DEFAULT_SHIPPING_FEE="120"

# 4. Cloudflare R2 Storage (S3 Compatible)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="exora-store"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-2a5d8e5eaff3498da143b1150b20a7c1.r2.dev"

# 5. Payment Gateways (Optional / Toggleable)
# Razorpay (India: UPI, Cards, Netbanking)
RAZORPAY_KEY_ID="rzp_test_xxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# Stripe (International)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxx"
STRIPE_SECRET_KEY="sk_test_xxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxx"

# 6. Email Delivery (Optional: Resend / SMTP)
RESEND_API_KEY="re_xxxxxx"
EMAIL_FROM="EXORA Studio <hello@exora.in>"
